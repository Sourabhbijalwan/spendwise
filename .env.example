# Local dev: matches docker-compose.yml. In production use your Neon / Vercel Postgres URL.
DATABASE_URL="postgresql://spendwise:spendwise@localhost:5432/spendwise"

# Optional: a direct (non-pooled) URL used only by `prisma migrate`.
# Set this on Vercel when DATABASE_URL is a pooled Neon URL.
# DIRECT_URL=""
